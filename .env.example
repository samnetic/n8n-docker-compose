# =============================================================================
# n8n Environment Configuration
# =============================================================================
# Copy to .env and customize for your deployment.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Version (MUST match between n8n and runners) ---
N8N_VERSION=2.0.3

# --- Secrets (REQUIRED - generate unique values!) ---
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_RUNNERS_AUTH_TOKEN=generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
REDIS_PASSWORD=generate-with-openssl-rand-hex-32

# --- URLs (REQUIRED for production) ---
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# --- Optional Settings ---
TZ=UTC
N8N_PORT=5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
WORKER_CONCURRENCY=10
N8N_LOG_LEVEL=info

# --- Resource Limits ---
N8N_MEMORY_LIMIT=2G
RUNNER_MEMORY_LIMIT=1G
REDIS_MAXMEMORY=256mb

# --- Code Node Modules (comma-separated) ---
# Must match packages installed in docker/Dockerfile.runners
NODE_FUNCTION_ALLOW_BUILTIN=crypto,fs,path,url,util
NODE_FUNCTION_ALLOW_EXTERNAL=lodash,moment,axios,xlsx,pdf-lib,uuid,date-fns

# --- Execution Data ---
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_TIMEOUT=3600
