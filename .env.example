# =============================================================================
# n8n Environment Configuration
# =============================================================================
# Copy to .env and customize for your deployment.
#
# SECRETS: Managed via Docker secrets (files in ./secrets/ directory).
#   Run `./n8n init local` to auto-generate them.
#   Secrets are mounted at /run/secrets/ inside containers.
#   See compose.yml `secrets:` block for details.
# =============================================================================

# --- Version (MUST match between n8n and runners) ---
N8N_VERSION=2.0.3

# --- Secrets ---
# Secrets are stored as files in ./secrets/ (generated by `./n8n init`).
# Do NOT put passwords or keys here. They are managed via Docker secrets:
#   secrets/n8n_encryption_key
#   secrets/n8n_runners_auth_token
#   secrets/postgres_password
#   secrets/redis_password

# --- URLs (REQUIRED for production) ---
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# --- Optional Settings ---
TZ=UTC
N8N_PORT=5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
WORKER_CONCURRENCY=10
N8N_LOG_LEVEL=info

# --- Resource Limits ---
N8N_MEMORY_LIMIT=2G
N8N_CPU_LIMIT=2.0
RUNNER_MEMORY_LIMIT=1G
RUNNER_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512M
REDIS_MEMORY_LIMIT=256M
REDIS_MAXMEMORY=256mb

# --- Code Node Modules (comma-separated) ---
# Must match packages installed in docker/Dockerfile.runners
# NOTE: `fs` is intentionally excluded for security
NODE_FUNCTION_ALLOW_BUILTIN=crypto,path,url,util
NODE_FUNCTION_ALLOW_EXTERNAL=lodash,moment,axios,xlsx,pdf-lib,uuid,date-fns

# --- Execution Data ---
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_TIMEOUT=3600
N8N_RUNNERS_TASK_TIMEOUT=60

# --- SMTP Configuration (uncomment and configure for email) ---
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.server.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your-email@email.com
# N8N_SMTP_PASS=                    # Use a Docker secret or app password
# N8N_SMTP_SENDER=Email Sender <your-email@email.com>
# N8N_SMTP_SSL=false
